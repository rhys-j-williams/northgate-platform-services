# Local stand-in for corporate AD. Same DIT shape as CN=APP-BEACON-OPS under OU=AppGroups.
# Passwords are local only. Do not add real handles here; use the roster in the estate notes.
dn: dc=meridian,dc=local
objectClass: top
objectClass: domain
dc: meridian

dn: ou=people,dc=meridian,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=meridian,dc=local
objectClass: organizationalUnit
ou: groups

dn: uid=beacon-ops,ou=people,dc=meridian,dc=local
objectClass: inetOrgPerson
uid: beacon-ops
cn: Beacon Ops
sn: Ops
mail: beacon-ops@example.com
userPassword: CHANGEME-beacon-ops

dn: uid=readonly,ou=people,dc=meridian,dc=local
objectClass: inetOrgPerson
uid: readonly
cn: Read Only
sn: User
mail: readonly@example.com
userPassword: CHANGEME-readonly

dn: cn=beacon-ops,ou=groups,dc=meridian,dc=local
objectClass: groupOfNames
cn: beacon-ops
member: uid=beacon-ops,ou=people,dc=meridian,dc=local

dn: cn=beacon-viewers,ou=groups,dc=meridian,dc=local
objectClass: groupOfNames
cn: beacon-viewers
member: uid=readonly,ou=people,dc=meridian,dc=local
