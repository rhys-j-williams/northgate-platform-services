{
  "name": "@meridian/documents-service",
  "version": "1.14.3",
  "private": true,
  "description": "Statements, tax documents and disclosure HTML for retail-web and business-web. Streams statement PDFs from statements-api through an object store.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.19.0 <19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r disclosures dist/",
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@meridian/domain-fixtures": "file:../../libs/ts/domain-fixtures",
    "axios": "1.6.8",
    "express": "4.18.2",
    "jose": "4.15.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "18.19.31",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  }
}
