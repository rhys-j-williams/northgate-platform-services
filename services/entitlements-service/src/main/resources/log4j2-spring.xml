<?xml version="1.0" encoding="UTF-8"?>
<!-- Local copy of common-starter's log4j2-meridian.xml minus the HEC appender. Splunk ingestion
     for this service is the k8s sidecar (fluent-bit -> HEC), see helm/values.yaml. When PLAT-1622
     lands this file goes away. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <JsonTemplateLayout eventTemplateUri="classpath:MeridianLayout.json"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="org.apache.kafka" level="WARN"/>
    <Logger name="org.hibernate" level="WARN"/>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
